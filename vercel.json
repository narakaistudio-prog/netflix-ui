{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/movie/:id",
      "destination": "/movie/[id]"
    },
    {
      "source": "/browse/:rowTitle",
      "destination": "/browse/[rowTitle]"
    }
  ],
  "functions": {
    "api/moviebox-play.mjs": {
      "regions": [
        "bom1"
      ],
      "maxDuration": 30
    }
  }
}
