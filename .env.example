# Free API key from https://www.themoviedb.org/settings/api
# Enables the live "Netflix India" catalog (TMDB tracks Netflix IN daily)
# and the episode generator in the admin screen.
# Without it the app uses the bundled catalog data.
EXPO_PUBLIC_TMDB_API_KEY=

# Optional: NHD paid/JSON API key.
# Embedded playback does NOT require a key — this is only for the ad-free
# paid plan and JSON-API endpoints (e.g. /api/subtitles).
EXPO_PUBLIC_NHD_API_KEY=
