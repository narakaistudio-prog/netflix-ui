# Netflix India discovery is refreshed server-side from the public FlixPatrol
# chart. No TMDB key is required or used by the catalog refresh.

# Optional server-side OMDb enrichment key. Keep this out of the client bundle.
# The GitHub refresh workflow reads OMDB_API_KEY from repository secrets.
OMDB_API_KEY=

# Optional: NHD paid/JSON API key.
# Embedded playback does NOT require a key — this is only for the ad-free
# paid plan and JSON-API endpoints (e.g. /api/subtitles).
EXPO_PUBLIC_NHD_API_KEY=

# Optional: base URL of an extra stream proxy. Usually NOT needed — the app
# ships same-origin Vercel functions (api/nxsha-api.mjs, api/stream.mjs) that
# already bypass nxsha's CORS/Referer walls on the deployed site. Set this only
# if you move that job to Render (server/extractor.mjs) or another host.
EXPO_PUBLIC_STREAM_PROXY=
