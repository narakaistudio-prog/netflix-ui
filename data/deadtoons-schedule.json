      "guide": {
        "3": {
          "1": {
            "title": "So Time Begins to Flow Again",
            "overview": "Following a devastating attack, Lu Guang returns to the time when he first met Cheng Xiaoshi, determined to prevent the future he witnessed. As he relives the beginning of their friendship, a series of seemingly ordinary encounters begins setting their shared destiny in motion once again.",
            "image": "https://image.tmdb.org/t/p/w300/5GOTfVNbkf2LvntZFo0ZyPei7z3.jpg",
            "airDate": "2024-12-27",
            "runtime": 66
          },
          "2": {
            "title": "Prelude",
            "overview": "While Liu Xiao becomes trapped in a dangerous wager at a Bridon bar, Cheng Xiaoshi discovers a photograph apparently sent by his missing father. Believing it may provide a clue about his parents, he decides to travel to Bridon, despite Qiao Ling’s strong objections.",
            "image": "https://image.tmdb.org/t/p/w300/i3xaHbChxgW5P9GBtYwR6o016Oq.jpg",
            "airDate": "2025-01-03",
            "runtime": 24
          },
          "3": {
            "title": "Them",
            "overview": "Following clues connected to Cheng Xiaoshi’s missing parents, he and Lu Guang arrive in Bridon and visit a bar popular with football supporters. There they meet the friendly Xia Fei, but an impulsive celebration provokes a rival group and draws the three into a dangerous chase through the city.",
            "image": "https://image.tmdb.org/t/p/w300/jEDO11g26w2bfcdyBRj9oEpClhU.jpg",
            "airDate": "2025-01-10",
            "runtime": 24
          },
          "4": {
            "title": "And Then There Were None",
            "overview": "After Xia Fei’s enigmatic boss, Vein, rescues the group from their pursuers, Lu Guang becomes suspicious of their new ally. Cheng Xiaoshi later returns to the bar seeking information about BAHATI, where he uncovers a connection to a language school destroyed in a devastating fire ten years earlier.",
            "image": "https://image.tmdb.org/t/p/w300/oND1N936VhQSIxxyVKwMc3sStBl.jpg",
            "airDate": "2025-01-17",
            "runtime": 21
          },
          "5": {
            "title": "Reunion",
            "overview": "After witnessing the academy fire, Cheng Xiaoshi and Lu Guang search for anyone who survived the disaster. Their investigation leads Cheng into a photograph belonging to Wang Qing, a gifted student trapped in a difficult situation, where he uncovers a personal connection that may bring him closer to the truth about his",
            "image": "https://image.tmdb.org/t/p/w300/7h5tBm4MfcPLFyJjowuQHD7GnIY.jpg",
            "airDate": "2025-01-24",
            "runtime": 25
          },
          "6": {
            "title": "Puzzle",
            "overview": "To earn Vein’s help in locating Wang Qing, Cheng Xiaoshi and Lu Guang agree to replace a missing model at a photo shoot. Their unusual payment leads them to Wang Qing’s mental health clinic, where her psychological tests begin raising unsettling questions about the people and hidden motives surrounding their investigat",
            "image": "https://image.tmdb.org/t/p/w300/djrOYPY0JBsQWbKEwpHJi06EPVv.jpg",
            "airDate": "2025-01-31",
            "runtime": 26
          }
        }
      }
