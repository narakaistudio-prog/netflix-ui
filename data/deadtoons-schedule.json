        },
        "from": "wikidata-tmdb"
      },
      "guide": {
        "2": {
          "1": {
            "title": "Roadhouse Blues",
            "overview": "While driving through Michigan, Frank stops for a beer at a roadside bar. But staying out of trouble has never been his strong suit.",
            "image": "https://image.tmdb.org/t/p/w300/p6b8Au2By66QENIUrmnc4tqydlN.jpg",
            "airDate": "2019-01-18",
            "runtime": 53
          },
          "2": {
            "title": "Fight or Flight",
            "overview": "Frank and a reluctant Rachel go on the run as a menacing adversary gives chase. Meanwhile, Madani pays Russo an unwelcome visit.",
            "image": "https://image.tmdb.org/t/p/w300/lDfOgz7tVzEFTssD07u8t95TuQ9.jpg",
            "airDate": "2019-01-18",
            "runtime": 54
          },
          "3": {
            "title": "Trouble the Water",
            "overview": "As Pilgrim's past comes into focus, Frank and Rachel find themselves in police custody, where they're anything but safe.",
            "image": "https://image.tmdb.org/t/p/w300/sTqiA7ye1rGJKlZsNZdqRulaGtL.jpg",
            "airDate": "2019-01-18",
            "runtime": 51
          },
          "4": {
            "title": "Scar Tissue",
            "overview": "Rachel recalls the night everything changed and lets Frank in on the truth about her name. Russo sits down with a face from his childhood.",
            "image": "https://image.tmdb.org/t/p/w300/tgGG2XChpNswv86Of74VcIqSrpz.jpg",
            "airDate": "2019-01-18",
            "runtime": 57
          },
          "5": {
            "title": "One-Eyed Jacks",
            "overview": "It's not a trap if you know it's coming: That's Frank's philosophy. Madani opens up and Pilgrim plans a visit to an unholy land.",
            "image": "https://image.tmdb.org/t/p/w300/75Z9dLKERPNbR0v3niEDAoFbGp5.jpg",
            "airDate": "2019-01-18",
            "runtime": 51
          },
          "6": {
            "title": "Nakazat",
            "overview": "Amy (formerly Rachel) develops photographs that point to a conspiracy. Russo reads his own report. Madani's story about Russo comes under fire.",
            "image": "https://image.tmdb.org/t/p/w300/2YnR28mHdFmPyvpflBRpPDEaNk6.jpg",
            "airDate": "2019-01-18",
            "runtime": 56
          },
          "7": {
            "title": "One Bad Day",
            "overview": "Madani's quest to ID Pilgrim hits a wall. Russo and his crew put their plan into action. Frank encounters someone from the past.",
            "image": "https://image.tmdb.org/t/p/w300/9gy9UYX2qi28zOcZ014XCv34Elx.jpg",
            "airDate": "2019-01-18",
            "runtime": 51
          },
          "8": {
            "title": "My Brother's Keeper",
            "overview": "Painful memories take ahold of Russo. Frank's frustration frightens those closest to him. Madani receives a visitor bearing a warning.",
            "image": "https://image.tmdb.org/t/p/w300/pxAQpGT7dC4iUqO9zrSCXiGpjQP.jpg",
            "airDate": "2019-01-18",
            "runtime": 48
          },
          "9": {
            "title": "Flustercluck",
            "overview": "A big bounty inspires New York's worst to pursue the Punisher. A restless Amy seeks help from a fellow grifter. Russo and Krista consider the future.",
            "image": "https://image.tmdb.org/t/p/w300/7gtOkfTTH7cNmAd5UAV9iwfMzZF.jpg",
            "airDate": "2019-01-18",
            "runtime": 57
          },
          "10": {
            "title": "The Dark Hearts of Men",
            "overview": "As Madani and Krista debate who's worth saving, Frank prepares to storm Russo's territory. A brutal encounter pushes Pilgrim back into old habits.",
            "image": "https://image.tmdb.org/t/p/w300/1EU6IbVLxK0GzNTykIumaYBnc8M.jpg",
            "airDate": "2019-01-18",
            "runtime": 47
          },
          "11": {
            "title": "The Abyss",
            "overview": "Amy rushes to protect Frank, who lies defenseless in a hospital. Pilgrim gets some crushing news, and Karen Page calls in a favor.",
            "image": "https://image.tmdb.org/t/p/w300/1jBcIeAyKftgDYIhNZsZXEFbik2.jpg",
            "airDate": "2019-01-18",
            "runtime": 54
          },
          "12": {
            "title": "Collision Course",
            "overview": "Buckle up -- Mahoney and Frank are about to take a ride to remember. Amy makes an entrance, Russo cashes out, and Madani comes clean to Krista.",
            "image": "https://image.tmdb.org/t/p/w300/iVCBLb45TLOXi1Pl3pT6YvaiK5Y.jpg",
            "airDate": "2019-01-18",
            "runtime": 49
          },
          "13": {
            "title": "The Whirlwind",
            "overview": "Frank, Pilgrim, Madani, Russo, Amy, Curt and the Schultz family. No bullet is left unspent as season two comes to an explosive conclusion.",
            "image": "https://image.tmdb.org/t/p/w300/oqu7NwokmhEQRCplas6wixHJ9H2.jpg",
            "airDate": "2019-01-18",
            "runtime": 57
          }
        }
      }
