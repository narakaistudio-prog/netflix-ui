    {
      "key": "sch-marvel-s-the-punisher-season-2-2019",
      "title": "Marvel's The Punisher",
      "slug": "marvel-s-the-punisher-season-2-2019",
      "url": "https://deadtoons.sbs/posts/marvel-s-the-punisher-season-2-2019",
      "img": "https://image.tmdb.org/t/p/w300/agNYq5XZnGfmYetUMyyM2RdPY70.jpg",
      "season": 2,
      "episode": 2,
      "audio": "",
      "day": "The",
      "date": "2026-10-16",
      "time": "2:22 PM",
      "today": true,
      "nx": {
        "id": "67178",
        "kind": "tv",
        "seasons": {
          "2": 2
        },
        "from": "wikidata-tmdb"
      },
      "guide": {
        "2": {
          "1": {
            "title": "Roadhouse Blues",
            "overview": "While driving through Michigan, Frank stops for a beer at a roadside bar. But staying out of trouble has never been his strong suit.",
            "image": "https://image.tmdb.org/t/p/w300/p6b8Au2By66QENIUrmnc4tqydlN.jpg",
            "airDate": "2019-01-18",
            "runtime": 53
          },
          "2": {
            "title": "Fight or Flight",
            "overview": "Frank and a reluctant Rachel go on the run as a menacing adversary gives chase. Meanwhile, Madani pays Russo an unwelcome visit.",
            "image": "https://image.tmdb.org/t/p/w300/lDfOgz7tVzEFTssD07u8t95TuQ9.jpg",
            "airDate": "2019-01-18",
            "runtime": 54
          },
          "3": {
            "title": "Trouble the Water",
            "overview": "As Pilgrim's past comes into focus, Frank and Rachel find themselves in police custody, where they're anything but safe.",
            "image": "https://image.tmdb.org/t/p/w300/sTqiA7ye1rGJKlZsNZdqRulaGtL.jpg",
            "airDate": "2019-01-18",
            "runtime": 51
          },
          "4": {
            "title": "Scar Tissue",
            "overview": "Rachel recalls the night everything changed and lets Frank in on the truth about her name. Russo sits down with a face from his childhood.",
            "image": "https://image.tmdb.org/t/p/w300/tgGG2XChpNswv86Of74VcIqSrpz.jpg",
            "airDate": "2019-01-18",
            "runtime": 57
          },
          "5": {
            "title": "One-Eyed Jacks",
            "overview": "It's not a trap if you know it's coming: That's Frank's philosophy. Madani opens up and Pilgrim plans a visit to an unholy land.",
            "image": "https://image.tmdb.org/t/p/w300/75Z9dLKERPNbR0v3niEDAoFbGp5.jpg",
            "airDate": "2019-01-18",
            "runtime": 51
          },
          "6": {
            "title": "Nakazat",
            "overview": "Amy (formerly Rachel) develops photographs that point to a conspiracy. Russo reads his own report. Madani's story about Russo comes under fire.",
            "image": "https://image.tmdb.org/t/p/w300/2YnR28mHdFmPyvpflBRpPDEaNk6.jpg",
            "airDate": "2019-01-18",
            "runtime": 56
          },
          "7": {
            "title": "One Bad Day",
            "overview": "Madani's quest to ID Pilgrim hits a wall. Russo and his crew put their plan into action. Frank encounters someone from the past.",
            "image": "https://image.tmdb.org/t/p/w300/9gy9UYX2qi28zOcZ014XCv34Elx.jpg",
            "airDate": "2019-01-18",
            "runtime": 51
          },
          "8": {
            "title": "My Brother's Keeper",
            "overview": "Painful memories take ahold of Russo. Frank's frustration frightens those closest to him. Madani receives a visitor bearing a warning.",
            "image": "https://image.tmdb.org/t/p/w300/pxAQpGT7dC4iUqO9zrSCXiGpjQP.jpg",
            "airDate": "2019-01-18",
            "runtime": 48
          },
          "9": {
            "title": "Flustercluck",
            "overview": "A big bounty inspires New York's worst to pursue the Punisher. A restless Amy seeks help from a fellow grifter. Russo and Krista consider the future.",
            "image": "https://image.tmdb.org/t/p/w300/7gtOkfTTH7cNmAd5UAV9iwfMzZF.jpg",
            "airDate": "2019-01-18",
            "runtime": 57
          },
          "10": {
            "title": "The Dark Hearts of Men",
            "overview": "As Madani and Krista debate who's worth saving, Frank prepares to storm Russo's territory. A brutal encounter pushes Pilgrim back into old habits.",
            "image": "https://image.tmdb.org/t/p/w300/1EU6IbVLxK0GzNTykIumaYBnc8M.jpg",
            "airDate": "2019-01-18",
            "runtime": 47
          },
          "11": {
            "title": "The Abyss",
            "overview": "Amy rushes to protect Frank, who lies defenseless in a hospital. Pilgrim gets some crushing news, and Karen Page calls in a favor.",
            "image": "https://image.tmdb.org/t/p/w300/1jBcIeAyKftgDYIhNZsZXEFbik2.jpg",
            "airDate": "2019-01-18",
            "runtime": 54
          },
          "12": {
            "title": "Collision Course",
            "overview": "Buckle up -- Mahoney and Frank are about to take a ride to remember. Amy makes an entrance, Russo cashes out, and Madani comes clean to Krista.",
            "image": "https://image.tmdb.org/t/p/w300/iVCBLb45TLOXi1Pl3pT6YvaiK5Y.jpg",
            "airDate": "2019-01-18",
            "runtime": 49
          },
          "13": {
            "title": "The Whirlwind",
            "overview": "Frank, Pilgrim, Madani, Russo, Amy, Curt and the Schultz family. No bullet is left unspent as season two comes to an explosive conclusion.",
            "image": "https://image.tmdb.org/t/p/w300/oqu7NwokmhEQRCplas6wixHJ9H2.jpg",
            "airDate": "2019-01-18",
            "runtime": 57
          }
        }
      }
    },
    {
      "key": "sch-the-elusive-samurai-season-2-2026",
      "title": "The Elusive Samurai",
      "slug": "the-elusive-samurai-season-2-2026",
      "url": "https://deadtoons.sbs/posts/the-elusive-samurai-season-2-2026",
      "img": "https://image.tmdb.org/t/p/w300/p0s5ymGzfM4zGQCVaU9MJOSaAWu.jpg",
      "season": 2,
      "episode": 11,
      "audio": "",
      "day": "The",
      "date": "2026-10-16",
      "time": "4:25 PM",
      "today": true,
      "nx": {
        "id": "222623",
        "kind": "tv",
        "seasons": {
          "2": 11
        },
        "from": "wikidata-tmdb"
      },
      "guide": {
        "2": {
          "1": {
            "title": "Longing for Sea Bream!",
            "overview": "It is the first year of the Kenmu era (1334), in Suwa, Shinano province. Tokiyuki, now fully accustomed to life in Suwa, is reminded of meals from his days in Kamakura during a casual conversation. He recalls how much he loved eating freshly caught sea bream from Yuigahama, seasoned with wasabi and soy sauce from Izu.",
            "image": "https://image.tmdb.org/t/p/w300/zkIkqDDc738DmfT741hNKPlIJ2T.jpg",
            "airDate": "2026-07-17",
            "runtime": 24
          },
          "2": {
            "title": "Ayako's Heart-Pounding Operation!",
            "overview": "The Ashikaga forces keep a vigilant watch across the country, searching for remnants of the Hojo clan scattered throughout Japan. Sadamune, the governor of Shinano, has grown suspicious of “Chojumaru,” a young warrior who has repeatedly distinguished himself in battle—first during the dog-shooting competition, and late",
            "image": "https://image.tmdb.org/t/p/w300/zPBDbcy3eBwPguyy0hWlU0Yxv5X.jpg",
            "airDate": "2026-07-24",
            "runtime": 24
          },
          "3": {
            "title": "Tokiyuki and Three Great Generals",
            "overview": "Provincial official Kiyohara returns to Shinano after fleeing back to Kyo following the previous battle. Having grown even more ruthless, Kiyohara launches a large-scale invasion against pro-Hojo factions in northern Shinano. To oppose the combined forces of Kiyohara and Sadamune, the three great generals of the Suwa f",
            "image": "https://image.tmdb.org/t/p/w300/uqbzSPqBxUT0yDKXI2NaqFMeu7x.jpg",
            "airDate": "2026-07-31",
            "runtime": 24
          },
          "4": {
            "title": "The Warrior of Love: Shinano Mask!",
            "overview": "Tokiyuki and his companions race across the battlefield, sparing even the slightest moments of rest in order to relay information to their allies. However, when they arrive at the northern front where Mochizuki and Tokoiwa are fighting, what they witness is a fortress engulfed in flames, falliing into ruin... Ayako col",
            "image": "https://image.tmdb.org/t/p/w300/kFOSkyzTSrq4Gxr2ovio3BsNS4E.jpg",
            "airDate": "2026-08-07",
            "runtime": 24
          },
          "5": {
            "title": "The Unyielding",
            "overview": "The central battlefield descends into total chaos. Just as victory seems within reach for the Hoshina–Shinomiya forces, a new obstacle suddenly appears before them: Kiyohara’s newly devised battle mikoshi. Originally intended as a palanquin for issuing commands from the rear, it is now reinforced with heavy armor.",
            "image": "https://image.tmdb.org/t/p/w300/6O5uCSow8osBNBb6Kj4fd7gib4o.jpg",
            "airDate": "2026-08-14",
            "runtime": 24
          },
          "6": {
            "title": "The Boy Who Became a God",
            "overview": "The battle ends in defeat for the Suwa Sect. Although they manage to keep casualties to a minimum, the losses they suffer are significant. As they look toward the next great conflict, everyone in the Suwa Sect comes to share an even stronger resolve. The battle becomes another valuable lesson for Tokiyuki as well—one t",
            "image": "https://image.tmdb.org/t/p/w300/AoOSvb63DJkNBk4tRU0XNsnjdjN.jpg",
            "airDate": "2026-08-21",
            "runtime": 24
          },
          "7": {
            "title": "My Uncle",
            "overview": "Tokiyuki’s uncle, Yasuie Hojo, is still alive! Once a key figure at the heart of the Kamakura Shogunate, Yasuie survives the fall of Kamakura. Afterward, he travels throughout the Tohoku region, continuing to fight alongside the remaining Hojo loyalists. But after suffering defeat after defeat, he eventually finds his ",
            "image": "https://image.tmdb.org/t/p/w300/aKq8cxE3EgR5nwmWffKzCxHRNpg.jpg",
            "airDate": "2026-08-28",
            "runtime": 24
          },
          "8": {
            "title": "Irreplaceable",
            "overview": "At the suggestion of Yorishige and Yasuie, Tokiyuki sets out for the capital, Kyo, together with the Elusive Warriors. Major Counselor Kinmune Saionji, an ally of Yasuie, awaits their arrival in Kyo. While Yasuie and Kinmune conduct a secret discussion, Tokiyuki and his companions venture out into the city.",
            "image": "https://image.tmdb.org/t/p/w300/cnudixNIlcnD230aJrTXeDDspK0.jpg",
            "airDate": "2026-09-04",
            "runtime": 24
          },
          "9": {
            "title": "The Man Called Masashige Kusunoki",
            "overview": "Having grown closer over a game of dice, Mima invites Tokiyuki and his companions on a tour of Kyo. Even though they know she is the daughter of their enemy, the Elusive Warriors accept her kindness and spend a brief, youthful moment enjoying themselves as ordinary boys and girls. However, upon returning to the Saionji",
            "image": "https://image.tmdb.org/t/p/w300/xRcKG1ifQN02KxfD4sIId9gKMRI.jpg",
            "airDate": "2026-09-11",
            "runtime": 24
          },
          "10": {
            "title": "The Night of the Assassination",
            "overview": "Through his dialogue with the warrior Masashige Kusunoki, known as a “god of war,” Tokiyuki is moved by Kusunoki's unwavering convictions and develops an even deeper sense of confidence in the possibilities of “fleeing.” Just as he is smiling over this fortunate encounter, everything suddenly changes when he hears news",
            "image": "https://image.tmdb.org/t/p/w300/3f4vF5ASY6PDJJOwfbNdrFYs7cn.jpg",
            "airDate": "2026-09-18",
            "runtime": 24
          },
          "11": {
            "title": "My Buddha, Part Two",
            "overview": "Although the attempt to assassinate Takauji ends in failure, Tokiyuki has grown significantly as a warrior through his experiences in Kyo. Upon his return to Suwa, Yorishige tells him that the time has finally come. The attempted assassinations of both the Emperor and Takauji plunged Kyo into chaos, where warriors from",
            "image": "https://image.tmdb.org/t/p/w300/kJVcoU30nlYtH07tODbObii3mw6.jpg",
            "airDate": "2026-09-25",
            "runtime": 24
          },
          "12": {
            "title": "The Age",
            "overview": "With preparations for war complete, the Suwa forces are finally about to ignite the great conflict. Tokiyuki is appointed commander-in-chief, taking command of the “Kamakura Party,” a unit formed from surviving retainers of the Hojo clan—while keeping his true identity hidden. Can he prove himself worthy as a leader to",
            "image": "https://image.tmdb.org/t/p/w300/A9pNtcCz4haWbeXvzcsudQPdjsl.jpg",
            "airDate": "2026-10-02",
            "runtime": 24
          }
        }
      }
    },
